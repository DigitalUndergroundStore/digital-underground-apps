<style>
:root{--bg:#11141a;--v1:#9a97e8;--v2:#9a97e8;--cy:#9a97e8;--tx:#e6e8ec;--mu:#a8acb5;--ln:rgba(79,70,229,0.14);--card:rgba(230,232,236,0.04)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.55 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
.w{max-width:1200px;margin:0 auto;padding:0 20px}
.gt{background:none;-webkit-background-clip: border-box;background-clip: border-box;color:#e6e8ec}
.glow{position:absolute;inset:-20% -10% auto;height:620px;pointer-events:none;background:transparent;filter:blur(10px);animation:drift 16s ease-in-out infinite alternate;z-index:0}
@keyframes drift{to{transform:translate3d(0,30px,0) scale(1.05)}}
.hero{position:relative;padding:84px 0 40px;overflow:hidden}.hero .w{position:relative;z-index:1}
.eyb{display:inline-flex;gap:8px;align-items:center;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--v2);padding:6px 12px;border:1px solid var(--ln);border-radius:99px;background:rgba(79,70,229,0.08)}
.eyb b{width:6px;height:6px;border-radius:50%;background:var(--du-accent-fill,#4f46e5);box-shadow: 0 0 10px var(--cy)}
h1{font-size:clamp(38px,6.4vw,72px);line-height:1.02;letter-spacing:-.035em;font-weight:800;margin:20px 0 16px;max-width:14ch}
.lead{font-size:clamp(16px,2vw,19px);color:var(--mu);max-width:56ch;margin:0 0 28px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 22px;border-radius:12px;font-weight:600;font-size:15px;transition:transform .2s,box-shadow .2s,background .2s}
.btn-p{background:var(--du-accent-fill,#4f46e5);color:#e6e8ec;box-shadow: none}.btn-p:hover{transform:translateY(-2px);box-shadow: none}
.btn-g{border:1px solid var(--ln);background:rgba(230,232,236,0.03)}.btn-g:hover{border-color:rgba(230,232,236,0.27)}
.row{display:flex;gap:12px;flex-wrap:wrap}
.stats{display:flex;gap:28px;flex-wrap:wrap;margin-top:36px;color:var(--mu);font-size:14px}.stats strong{display:block;color:var(--tx);font-size:22px;font-weight:700}
.tabs{position:sticky;top:0;z-index:20;background:rgba(17,20,26,0.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--ln)}
.tabs .w{display:flex;gap:6px;overflow-x:auto;padding-top:10px;padding-bottom:10px;scrollbar-width:none}.tabs a{white-space:nowrap;font-size:14px;font-weight:500;color:var(--mu);padding:7px 14px;border-radius:99px;border:1px solid transparent;transition:.2s}
.tabs a:hover,.tabs a.on{color:var(--tx);border-color:var(--ln);background:rgba(79,70,229,0.12)}
section.s{padding:56px 0 8px;scroll-margin-top:60px}.sh{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:22px}
.sh h2{font-size:clamp(24px,3vw,32px);letter-spacing:-.02em;margin:0;font-weight:700}.sh span{color:var(--mu);font-size:14px}
.g{display:grid;gap:18px;grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
.gf{display:grid;gap:18px;grid-template-columns:repeat(6,1fr)}.gf .pc{grid-column:span 2}.gf .pc:nth-child(-n+2){grid-column:span 3}
.pc{position:relative;display:flex;flex-direction:column;border-radius:18px;background:var(--card);border:1px solid var(--ln);overflow:hidden;transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .3s,box-shadow .35s}
.pc::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;background:transparent;-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .3s;pointer-events:none}
.pc:hover{transform:translateY(-5px);box-shadow: none}.pc:hover::before{opacity:1}
.pc-cv{aspect-ratio:16/10;overflow:hidden;background:#1a1e26}.pc-cv img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.8,.2,1)}.pc:hover .pc-cv img{transform:scale(1.05)}
.pc-b{display:flex;flex-direction:column;gap:6px;padding:16px 18px 18px;flex:1}.pc-b strong{font-size:17px;font-weight:650;letter-spacing:-.01em}
.pc-d{color:var(--mu);font-size:14px;line-height:1.5;flex:1}.pc-r{display:flex;justify-content:space-between;align-items:center;margin-top:10px}
.pc-p{font-weight:700;font-size:16px}.pc-c{font-size:13px;font-weight:600;color:var(--cy);padding:6px 12px;border-radius:99px;background:rgba(79,70,229,0.08);border:1px solid rgba(230,232,236,0.2);transition:.2s}
.pc-c i{font-style:normal;display:inline-block;transition:transform .2s}.pc:hover .pc-c{background:rgba(79,70,229,0.16)}.pc:hover .pc-c i{transform:translateX(3px)}
.pc-f .pc-b strong{font-size:20px}
.pc{cursor:pointer}.pc-a::after{content:"";position:absolute;inset:0;z-index:1;border-radius:inherit}.pc-c{position:relative;z-index:2}.pc-a:focus-visible{outline:none}.pc:has(.pc-a:focus-visible){outline:2px solid var(--cy);outline-offset:3px}
.rv{opacity:0;transform:translateY(18px)}.rv.in{opacity:1;transform:none;transition:opacity .7s ease,transform .7s cubic-bezier(.2,.8,.2,1)}
.trust{margin:64px 0 72px;display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.trust div{padding:22px;border:1px solid var(--ln);border-radius:16px;background:var(--card)}.trust b{display:block;margin-bottom:4px}.trust span{color:var(--mu);font-size:14px}
/* detail */
.dt{display:grid;gap:40px;grid-template-columns:1.15fr 1fr;align-items:start;padding:40px 0 30px}
.dt-m{border-radius:22px;overflow:hidden;border:1px solid var(--ln);background:#161a21;box-shadow: none}.dt-m img{width:100%}
.crumb{font-size:13px;color:var(--mu);margin-bottom:14px}.crumb a:hover{color:var(--tx)}
.dt h1{font-size:clamp(34px,5vw,54px);margin:10px 0 12px}.price{font-size:34px;font-weight:800;margin:6px 0 20px}
.buy{position:relative;width:100%;justify-content:center;font-size:17px;padding:16px}.buy-row{display:grid;gap:10px;margin:0}.buy-row .buy{width:100%}.btn-g.buy{font-size:16px;padding:14px}.sticky-buy .buy-row{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}.sticky-buy .buy-row .btn{padding:11px 14px;font-size:13px;width:auto}
.feat{list-style:none;padding:0;margin:26px 0 0;display:grid;gap:10px}.feat li{display:flex;gap:10px;color:var(--mu);font-size:15px}.feat li::before{content:"";flex:none;width:18px;height:18px;margin-top:2px;border-radius:50%;background:transparent}
.note{font-size:13px;color:var(--mu);margin-top:12px;text-align:center}
.sticky-buy{display:none}
@media(max-width:860px){.gf{grid-template-columns:1fr 1fr}.gf .pc,.gf .pc:nth-child(-n+2){grid-column:span 1}.gf .pc:first-child{grid-column:span 2}.dt{grid-template-columns:1fr;gap:24px;padding-top:20px}
.sticky-buy{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:40;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:#11141a;backdrop-filter:blur(12px);border-top:1px solid var(--ln);align-items:center;justify-content:space-between;gap:12px}.sticky-buy .btn{padding:11px 20px}.has-sb .duf{padding-bottom:84px}}
@media(max-width:520px){.hero{padding:56px 0 24px}.g{grid-template-columns:1fr 1fr;gap:12px}.gf{gap:12px}.pc-b{padding:12px}.pc-b strong{font-size:15px}.pc-d{display:none}.pc-f .pc-d{display:block}.pc-r{flex-direction:column;align-items:flex-start;gap:8px}.pc-c{padding:5px 10px}.stats{gap:20px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}
@media(max-width:520px){.dt{gap:18px;padding-top:12px}.dt-m{border-radius:16px}.dt-m img{display:block;width:100%;aspect-ratio:16/9;height:auto;max-height:440px;object-fit:cover}.dt h1{font-size:30px;line-height:1.1;margin:8px 0 10px}.dt .lead{font-size:16px;line-height:1.55}}.dt-m-hd{aspect-ratio:16/9;max-height:none;align-self:start;grid-column:1/-1;width:100%;max-width:1120px;justify-self:center}.dt-m-hd picture,.dt-m-hd img{width:100%;height:100%;object-fit:cover;display:block}@media(max-width:520px){.dt-m-hd img{aspect-ratio:16/9!important}}.dt-m-hd+div{grid-column:1/-1;width:100%;max-width:860px;justify-self:center}.price{letter-spacing:-.02em}.price span{letter-spacing:0}
.fnd{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:-8px 0 22px;padding:12px 16px;border:1px solid rgba(154,151,232,.32);border-radius:12px;background:linear-gradient(90deg,rgba(154,151,232,.12),rgba(154,151,232,.03));font-size:14px;line-height:1.5}
.fnd-t{flex:none;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#11141a;background:var(--v1);padding:4px 9px;border-radius:99px}
code{font:600 .92em ui-monospace,SFMono-Regular,Menlo,monospace;padding:1px 6px;border-radius:6px;background:rgba(230,232,236,.08);border:1px solid rgba(230,232,236,.14);color:var(--tx)}
.cmpw{overflow-x:auto;border:1px solid var(--ln);border-radius:16px;background:var(--card)}
.cmp{width:100%;border-collapse:collapse;font-size:15px;min-width:520px}.cmp th,.cmp td{padding:13px 16px;border-bottom:1px solid var(--ln);text-align:left;vertical-align:top}
.cmp th{font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mu)}.cmp .c,.cmp .fr,.cmp .pro{text-align:center}.cmp .fr{color:var(--mu)}
.cmp th.pro{color:var(--v1)}.cmp td:last-child{background:rgba(154,151,232,.06);color:var(--tx);font-weight:500}.cmp tr:last-child td{border-bottom:0;font-weight:700}
.fq{border:1px solid var(--ln);border-radius:12px;padding:14px 18px;background:var(--card);transition:border-color .2s}.fq[open]{border-color:rgba(154,151,232,.35)}
.fq summary{font-weight:600;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:12px}.fq summary::-webkit-details-marker{display:none}.fq summary::after{content:"+";color:var(--mu);font-weight:400;transition:transform .2s}.fq[open] summary::after{transform:rotate(45deg)}
.fq p{color:var(--mu);margin:10px 0 0;line-height:1.6}
section.s{padding-top:64px}.sh{flex-wrap:wrap}
@media(max-width:860px){.sticky-buy>div{min-width:0}.sticky-buy>div div{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sticky-buy .btn{flex:none}}
</style><link rel="stylesheet" href="/assets/site-nav/site-nav.css?v=42">
<link rel="stylesheet" href="/assets/theme-clean.css?v=2">
</head><body class="has-sb">
<!--du-site-nav--><header class="dun"><div class="dun-in"><a class="dun-logo" href="/" aria-label="Digital Underground home"><img class="dun-full" src="/assets/logo/du-horizontal.svg" alt="Digital Underground" width="189" height="34"></a><nav class="dun-links" aria-label="Primary"><a href="/">Marketplace</a><a href="/league/">League</a><a href="/makers/">Creators</a></nav><div class="dun-right"><a class="dun-mp" href="/store/p/maker-pro/">Maker Pro</a><div class="dun-acct" id="dunAcct"><button type="button" class="dun-acct-btn dun-menu-btn" id="dunAcctBtn" aria-label="Open menu" aria-controls="dunDrawer" aria-expanded="false" aria-haspopup="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button></div></div></div><nav class="dun-drawer" id="dunDrawer" aria-label="Site menu"><div class="dun-drawer-acct" id="dunDrawerAcct" role="group" aria-label="Account"><div class="dun-drawer-who"><span class="av mark" aria-hidden="true"><img src="/assets/logo/du-mark-white.svg" alt="" width="36" height="36"></span><span class="nm">Account</span></div><a href="/community/dashboard/">Sign in</a></div><a href="/">Marketplace</a><a href="/league/">League</a><a href="/makers/">Creators</a><a href="/community/submit/">List your project free</a><a href="/store/p/maker-pro/">Maker Pro</a><button type="button" class="dun-share-btn" data-dun-share>Share this page</button></nav></header><script src="/assets/site-nav/site-nav.js?v=43" defer></script><!--/du-site-nav-->
<main class="w" id="main"><div class="dt"><div class="dt-m dt-m-hd rv in"><picture><source srcset="/store/covers/maker-pro-hd.webp?v=hd4usd" type="image/webp"><img src="/store/covers/maker-pro-hd.jpg?v=hd4usd" width="1920" height="1080" alt="Digital Underground Maker Pro" fetchpriority="high" decoding="async"></picture></div><div class="rv in"><div class="crumb"><a href="/store/">Store</a> / Makers</div><span class="eyb"><b></b>Membership</span><h1>Get your work in front of buyers.</h1><p class="lead">Publishing on Digital Underground is free and always will be. Maker Pro is for makers who want reach: Featured slots, promo on Digital Underground&rsquo;s X and socials, promotion from DU, and warm intros to buyers and builders.</p>
<p style="margin:-6px 0 14px;color:var(--mu);font-size:15px;line-height:1.5"><strong style="color:inherit">Who it&rsquo;s for:</strong> makers with a live product who want more eyes on it. <strong style="color:inherit">Not for:</strong> anyone who just wants to list. That&rsquo;s free.</p>
<div class="price">$9<span style="font-size:15px;font-weight:500;color:var(--mu)">/mo</span> · $79<span style="font-size:15px;font-weight:500;color:var(--mu)">/yr</span></div>
<p class="fnd"><span class="fnd-t">Founding 25</span><span>First 25 makers get <strong>$59/yr</strong>, locked in. Use code <code>FOUNDING25</code> at checkout.</span></p>
<ul style="margin:0 0 20px;padding-left:18px;color:var(--mu);line-height:1.7"><li><strong style="color:var(--tx)">Draft/Live control</strong>: pull a listing offline or relaunch it whenever you like</li><li><strong style="color:var(--tx)">Featured slots</strong>: 1 rotating 7-day slot on the store homepage (2 on yearly)</li><li><strong style="color:var(--tx)">DU promo channels</strong>: a dedicated post on Digital Underground&rsquo;s X each month, plus the weekly Maker Roundup</li><li><strong style="color:var(--tx)">Network intros</strong>: up to one warm, double-opt-in intro per month</li></ul>
<div class="buy-row">
<a class="btn btn-p buy" href="https://buy.stripe.com/dRm9AVgKgbtf94y8KC0ZW01" target="_blank" rel="noopener">Monthly $9</a>
<a class="btn btn-g buy" href="https://buy.stripe.com/9B6cN7fGc2WJ3Kee4W0ZW02" target="_blank" rel="noopener">Yearly $79</a>
<a class="btn btn-g buy" href="https://buy.stripe.com/5kQeVf8dK68V94y6Cu0ZW03" target="_blank" rel="noopener">Founding $59/yr · first 25 makers</a>
</div>
<p class="note">Billing is by Stripe · cancel anytime · listings stay live if you cancel</p>
<p class="note" style="margin-top:10px">Want it done for you instead? See <a href="/store/p/networking-distribution/">Networking &amp; Distribution</a> ($69 one-time).</p></div></div>
<nav class="tabs" aria-label="Sections" style="margin:0 -20px"><div class="w"><a href="#compare">Free vs Pro</a><a href="#weekly">What you get</a><a href="#featured">Featured rules</a><a href="#faq">FAQ</a></div></nav>
<section class="s" id="compare"><div class="sh"><h2>Free vs Pro</h2><span>Publishing is free. Pro adds reach.</span></div><div class="cmpw"><table class="cmp"><thead><tr><th>Feature</th><th class="c">Free</th><th class="pro">Maker Pro</th></tr></thead><tbody><tr><td>List a product (Draft)</td><td class="fr">✓</td><td class="c">✓</td></tr><tr><td>Edit &amp; save to go Live</td><td class="fr">✓</td><td class="c">✓</td></tr><tr><td>Maker profile &amp; store listing</td><td class="fr">✓</td><td class="c">✓</td></tr><tr><td>Draft/Live toggle (pull offline, relaunch anytime)</td><td class="fr">—</td><td class="c">✓</td></tr><tr><td>Featured slots on store homepage &amp; category top</td><td class="fr">—</td><td class="c">1 (monthly) · 2 (yearly)</td></tr><tr><td>Promo on Digital Underground&rsquo;s X &amp; socials</td><td class="fr">—</td><td class="c">1 dedicated post/mo + weekly Maker Roundup</td></tr><tr><td>Promotion from DU (shares, quotes, launch pushes)</td><td class="fr">—</td><td class="c">✓</td></tr><tr><td>Warm intros to buyers &amp; builders</td><td class="fr">—</td><td class="c">Up to 1/mo, double opt-in</td></tr><tr><td>Price</td><td class="fr">Free, always</td><td class="c">$9/mo · $79/yr</td></tr></tbody></table></div></section>
<section class="s" id="weekly"><div class="sh"><h2>What you get each week</h2><span>Here&rsquo;s what we do for Pro makers</span></div><div class="trust" style="margin:0">
<div><b>Monday · Featured rotation</b><span>We assign and rotate Featured slots and update the store homepage row.</span></div>
<div><b>Tuesday · X promo</b><span>One dedicated post per Pro maker each month, plus a spot in the weekly Maker Roundup thread on Digital Underground&rsquo;s X.</span></div>
<div><b>Wednesday · Cross-posts</b><span>The roundup goes out on Bluesky, our Facebook Page and other DU social channels.</span></div>
<div><b>Thursday · Intros</b><span>Up to one warm, double-opt-in intro per month to a buyer or builder in the DU network.</span></div>
<div><b>Friday · Your recap</b><span>A short email listing the posts, intros and Featured placements we ran for you that week.</span></div>
</div></section>
<section class="s" id="featured"><div class="sh"><h2>Featured rules</h2><span>Fair rotation, same rules for everyone</span></div><div style="max-width:760px;border:1px solid var(--ln);border-radius:16px;background:var(--card);padding:18px 22px"><ul style="margin:0;padding-left:18px;color:var(--mu);line-height:1.8">
<li><strong style="color:var(--tx)">Monthly:</strong> 1 active Featured slot, 7 days per slot, up to 4 rotations a month.</li>
<li><strong style="color:var(--tx)">Yearly:</strong> 2 active Featured slots, 7 days each, rotating.</li>
<li><strong style="color:var(--tx)">Where:</strong> the store homepage Featured row and the top of your category.</li>
<li><strong style="color:var(--tx)">Cap:</strong> at most 8 live Featured slots store-wide. Extra requests wait in a first-in, first-out queue.</li>
<li><strong style="color:var(--tx)">Eligibility:</strong> the item must be Live and have a cover image, a price and a working link.</li>
<li>Digital Underground can remove a Featured item that breaks these rules.</li>
</ul></div></section>
<section class="s" id="faq"><div class="sh"><h2>Questions</h2></div><div style="display:grid;gap:10px;max-width:760px"><details class="fq"><summary>Is publishing still free?</summary><p>Yes, and it always will be. Free makers list a product as a Draft, then edit and save it to go Live. Maker Pro sells reach, not access.</p></details><details class="fq"><summary>How does Pro unlock?</summary><p>Sign in to your <a href="/community/dashboard/">creator dashboard</a> with the same email you used at checkout and Pro turns on automatically. Or paste the license key from your receipt under Settings → Maker Pro.</p></details><details class="fq"><summary>Can I cancel anytime?</summary><p>Yes. Cancel from your Gumroad library whenever you like. Pro stays active until the end of the period you paid for.</p></details><details class="fq"><summary>What happens if Pro lapses?</summary><p>Your listings stay live. Featured items finish their current 7-day slot and then drop off, and the Draft/Live toggle, promo and intro requests switch off until you renew.</p></details><details class="fq"><summary>What is the founding price?</summary><p>The first 25 makers get Maker Pro for $59/year (normally $79/year), with code <code>FOUNDING25</code> at checkout. Once the 25 seats are gone, it&rsquo;s gone.</p></details><details class="fq"><summary>How fast do promo and intros happen?</summary><p>Promo requests go live within 7 days. Intro requests get an answer within 14 days. Every Friday you get a short &ldquo;what we did for you&rdquo; email.</p></details><details class="fq"><summary>Monthly or yearly?</summary><p>Yearly is $79 (about 2 months free) and gets 2 active Featured slots instead of 1.</p></details></div>
<p style="color:var(--mu);font-size:14px;margin-top:14px">More questions? <a href="/support/" style="text-decoration:underline">Ask us</a> or email <a href="mailto:digitalunderground.store@proton.me" style="text-decoration:underline">digitalunderground.store@proton.me</a>.</p></section>
<div style="height:60px"></div></main><div class="sticky-buy"><div><strong>Maker Pro</strong><div style="color:var(--mu);font-size:14px">$9/mo · $79/yr · Billing is by Stripe</div></div><div class="buy-row"><a class="btn btn-p" href="https://buy.stripe.com/dRm9AVgKgbtf94y8KC0ZW01" target="_blank" rel="noopener">Monthly $9</a><a class="btn btn-g" href="https://buy.stripe.com/9B6cN7fGc2WJ3Kee4W0ZW02" target="_blank" rel="noopener">Yearly $79</a><a class="btn btn-g" href="https://buy.stripe.com/5kQeVf8dK68V94y6Cu0ZW03" target="_blank" rel="noopener">Founding $59/yr</a></div></div>
<script>const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -6% 0px'});
document.querySelectorAll('.rv').forEach((el,i)=>{el.style.transitionDelay=(i%4)*70+'ms';io.observe(el)});
setTimeout(function(){document.querySelectorAll('.rv:not(.in)').forEach(function(el){el.classList.add('in')})},900);
const tabs=[...document.querySelectorAll('.tabs a')];if(tabs.length){const so=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)tabs.forEach(t=>t.classList.toggle('on',t.hash==='#'+e.target.id))}),{rootMargin:'-40% 0px -55% 0px'});document.querySelectorAll('section.s').forEach(s=>so.observe(s))}</script>
