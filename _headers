/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/globe/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/globe/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/globe/globe.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/parts/*
  X-Robots-Tag: noindex

/games/*
  X-Robots-Tag: noindex
/assets/signup.js
  Cache-Control: public, max-age=0, must-revalidate
/p/airhand/*
  X-Robots-Tag: noindex

# Developer Marketplace: CSP as a second line of defence (inline scripts are still allowed; no third-party scripts except Turnstile).
/community/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://player.vimeo.com; connect-src 'self' https://challenges.cloudflare.com; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
